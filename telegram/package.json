{
  "name": "the-lantern-telegram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "dev:poll": "TELEGRAM_MODE=polling bun run --watch src/server/index.ts",
    "dev:miniapp": "vite",
    "start": "bun run src/server/index.ts",
    "build": "bun run build:server && bun run build:miniapp",
    "build:server": "bun build src/server/index.ts --outdir dist --target bun",
    "build:miniapp": "vite build",
    "type-check": "tsc --noEmit",
    "test": "bun test ./tests",
    "test:watch": "bun test --watch ./tests",
    "lint": "eslint src tests app/src --max-warnings 0"
  },
  "dependencies": {
    "grammy": "^1.36.3",
    "hono": "^4.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.1.5"
  }
}
