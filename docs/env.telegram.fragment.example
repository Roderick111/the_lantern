# Paste into server .env.production (never commit real secrets)
# Telegram gateway — bot.thelantern.institute

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random
MINIAPP_SESSION_SECRET=replace-with-long-random
TELEGRAM_PUBLIC_URL=https://bot.thelantern.institute
LANTERN_ENGINE_URL=http://backend:8000
TELEGRAM_MODE=webhook
PORT=8080
TELEGRAM_DB_PATH=/app/data/telegram.db
ASSETS_PATH=/app/assets
FEATURE_NEW_SESSIONS=true
FEATURE_LLM_TURNS=true
FEATURE_MINIAPP_MUTATIONS=true
RETENTION_DAYS=7
ENGINE_TIMEOUT_MS=60000
LETSENCRYPT_EMAIL=admin@thelantern.institute
